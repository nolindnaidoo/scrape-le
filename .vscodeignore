# Allow-list packaging: everything is excluded except what the extension
# needs at runtime. dist/extension.js is an esbuild bundle that is fully
# self-contained except for playwright-core, which cannot be bundled and
# ships under node_modules/ — both enforced by scripts/check-bundle.js.
**

!dist/extension.js
!node_modules/playwright-core/**
!package.nls.json
!package.nls.*.json
!src/assets/images/icon.png
!README.md
!CHANGELOG.md
!LICENSE
